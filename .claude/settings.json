{
   "env":{
    "LINEAR_API_KEY_CMD": "security find-generic-password -a $USER -s flotilla-linear-key -w",
    "GITHUB_TOKEN_CMD": "security find-generic-password -a $USER -s flotilla-github-token -w",
     "NODE_USE_ENV_PROXY": "1"
  }, 
  "enabledPlugins": {
    "flotilla@formtrieb": false
  },
  "permissions": {
    "allow": [
      "Bash(npx @formtrieb/flotilla-engine:*)",
      "Bash(npx tsx tools/wave/src/cli.ts:*)",
      "Bash(npx tsx src/cli.ts:*)",
      "Bash(npx tsx src/issue-store-cli.ts:*)",
      "Bash(npx tsx src/cross-wave-cli.ts:*)",
      "Bash(npx tsx src/host-pr-cli.ts:*)",
      "Bash(./node_modules/.bin/tsx src/cli.ts:*)",
      "Bash(./node_modules/.bin/tsx src/issue-store-cli.ts:*)",
      "Bash(./node_modules/.bin/tsx src/cross-wave-cli.ts:*)",
      "Bash(tools/wave/node_modules/.bin/tsx tools/wave/src/cli.ts:*)",
      "Bash(./tools/wave/node_modules/.bin/tsx tools/wave/src/cli.ts:*)",
      "Bash(NODE_USE_ENV_PROXY=1 npx @formtrieb/flotilla-engine:*)",
      "Bash(NODE_USE_ENV_PROXY=1 npx tsx tools/wave/src/cli.ts:*)",
      "Bash(NODE_USE_ENV_PROXY=1 npx tsx src/cli.ts:*)",
      "Bash(NODE_USE_ENV_PROXY=1 npx tsx src/issue-store-cli.ts:*)",
      "Bash(NODE_USE_ENV_PROXY=1 npx tsx src/cross-wave-cli.ts:*)",
      "Bash(NODE_USE_ENV_PROXY=1 npx tsx src/host-pr-cli.ts:*)",
      "Bash(NODE_USE_ENV_PROXY=1 ./node_modules/.bin/tsx src/cli.ts:*)",
      "Bash(NODE_USE_ENV_PROXY=1 ./node_modules/.bin/tsx src/issue-store-cli.ts:*)",
      "Bash(NODE_USE_ENV_PROXY=1 ./node_modules/.bin/tsx src/cross-wave-cli.ts:*)",
      "Bash(NODE_USE_ENV_PROXY=1 tools/wave/node_modules/.bin/tsx tools/wave/src/cli.ts:*)",
      "Bash(NODE_USE_ENV_PROXY=1 ./tools/wave/node_modules/.bin/tsx tools/wave/src/cli.ts:*)"
    ],
    "deny": [
      "Read(.claude/settings.local.json)",
      "Read(**/.claude/settings.local.json)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(cat .claude/settings.local.json:*)",
      "Bash(less .claude/settings.local.json:*)",
      "Bash(more .claude/settings.local.json:*)",
      "Bash(head .claude/settings.local.json:*)",
      "Bash(tail .claude/settings.local.json:*)",
      "Bash(cat .env:*)",
      "Bash(less .env:*)",
      "Bash(more .env:*)",
      "Bash(head .env:*)",
      "Bash(tail .env:*)",
      "Bash(security find-generic-password -a $USER -s flotilla-github-token -w:*)",
      "Bash(security find-generic-password -a $USER -s flotilla-linear-key -w:*)"
    ]
  }
}
